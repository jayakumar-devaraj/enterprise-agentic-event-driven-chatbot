# Every config key with its default. Copy to .env and fill the labeled placeholders.
# Secrets belong only in .env (git-ignored); never commit real values.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PARTITIONS=4
KAFKA_TOPIC=chat-requests
KAFKA_DLQ_TOPIC=chat-requests.dlq
KAFKA_CONSUMER_GROUP=chat-workers
# How long chat-requests keeps records (applied by kafka-init); DEDUPE_TTL_S must outlive both summed
KAFKA_RETENTION_MS=604800000
KAFKA_SEGMENT_MS=86400000

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant + embeddings
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_COLLECTION=intents
QDRANT_INJECTION_COLLECTION=injection_patterns
QDRANT_BENIGN_COLLECTION=benign_patterns
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Set once by leave-one-out calibration over the seed files (ADR 0004). Never tune to pass a test.
ROUTE_THRESHOLD=0.5821
INJECTION_MARGIN=-0.0149

# PII
SPACY_MODEL=en_core_web_lg

# Inference (OpenAI-compatible; must stay inside the compose network)
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:1b
LLM_MAX_TOKENS=256
MOCK_LLM=true
INFERENCE_TIMEOUT_S=60
MAX_RETRIES=2
RETRY_BACKOFF_MAX_S=4

# Idempotency (DEDUPE_LEASE_S must exceed INFERENCE_TIMEOUT_S*(MAX_RETRIES+1)+RETRY_BACKOFF_MAX_S*MAX_RETRIES)
# and DEDUPE_TTL_S*1000 must exceed KAFKA_RETENTION_MS+KAFKA_SEGMENT_MS
DEDUPE_LEASE_S=200
DEDUPE_TTL_S=777600

# Memory + streams
CHECKPOINT_TTL_MIN=1440
STREAM_MAXLEN=2000
STREAM_TTL_S=3600
STREAM_BLOCK_MS=5000

# Gateway guardrails
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_PER_MIN=20
CORS_ORIGINS=http://localhost:5173
# PLACEHOLDER: comma-separated user:scrypt-hash pairs; generate with the helper documented in the README.
AUTH_USERS=REPLACE_ME_user:scrypt-hash

# Human approval gate
APPROVAL_TTL_S=3600

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
LANGFUSE_PUBLIC_KEY=REPLACE_ME_langfuse_public_key
LANGFUSE_SECRET_KEY=REPLACE_ME_langfuse_secret_key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LOG_LEVEL=INFO
HF_HUB_OFFLINE=1

# Tenancy: the gateway maps a username to a document tenant (SPEC §3). Format user:tenant,...
USER_TENANTS=

# Document questions (RAG service). Leave RAG_TENANT_TOKENS empty to switch the feature off.
RAG_BASE_URL=http://rag-api:8000
# One deadline for the whole call; with RAG on it must be below INFERENCE_TIMEOUT_S
RAG_TIMEOUT_S=20
RAG_MAX_TOKENS=256
# Cap on document text placed in one prompt
RAG_CONTEXT_CHARS=12000
# PLACEHOLDER: comma-separated token:tenant pairs, the RAG service's TENANT_TOKENS format; the same
# value is passed to rag-api. Tokens are secrets and must not contain ':' or ','.
RAG_TENANT_TOKENS=
